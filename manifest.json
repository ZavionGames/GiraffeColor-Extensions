{
  "manifest_version": 3,
  "name": "Giraffe Color",
  "description": "Ekrandan renk seç, kodunu kopyala ve kendi renk paletini oluştur.",
  "version": "1.3.2",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "minimum_chrome_version": "99",
  "icons": { "16":"icon-16.png", "32":"icon-32.png", "48":"icon-48.png", "128":"icon.png" },
  "action": { "default_title": "Giraffe Color", "default_popup": "popup.html", "default_icon": {"16":"icon-16.png","32":"icon-32.png","48":"icon-48.png","128":"icon.png"} }
}
